type Listener = (payload: any) => void;
function cleanError(error: unknown) {
  const raw = error instanceof Error ? error.message : String(error);
  return raw.replace(/^Error invoking remote method '[^']+':\s*/i, '').replace(/^Error:\s*/i, '').trim();
}
async function invoke<T = any>(channel: string, ...args: any[]): Promise<T> {
  try { return await ipcRenderer.invoke(channel, ...args) as T; }
  catch (error) { throw new Error(cleanError(error) || `Falha em ${channel}`); }
}
const on = (channel: string, callback: Listener) => { const handler = (_event: IpcRendererEvent, payload: any) => callback(payload); ipcRenderer.on(channel, handler); return () => ipcRenderer.removeListener(channel, handler); };

