# ================================
# LICENCIAMENTO ED25519
# A chave privada NUNCA deve usar prefixo VITE_ e nunca vai para o navegador.
# Use \n para representar quebras de linha na Vercel.
# ================================
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
