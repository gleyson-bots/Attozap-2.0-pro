# ================================
# LANDING PÚBLICA
# ================================
VITE_SALES_WHATSAPP=5511999999999
VITE_SALES_EMAIL=vendas@orbitalcode.shop
APP_URL=https://attozap.orbitalcode.shop

# ================================
# TURSO / LIBSQL
# ================================
TURSO_DATABASE_URL=libsql://database-attozap-vercel-icfg-hejbugwpmppsj7cwd1o9ufso.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=COLE_O_TOKEN_SOMENTE_NA_VERCEL

# ================================
# AUTENTICAÇÃO DO PORTAL
# Gere uma chave longa e aleatória (mínimo 32 caracteres)
# ================================
AUTH_SECRET=GERE_UMA_CHAVE_FORTE_NA_VERCEL
ADMIN_NAME=Administrador ATTOZAP
ADMIN_EMAIL=admin@orbitalcode.shop
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_NA_VERCEL

# ================================
# GOOGLE reCAPTCHA v2 CHECKBOX
# Site Key é pública e vai para o bundle Vite; Secret Key é apenas server-side.
# Cadastre os domínios do portal no console do reCAPTCHA.
# ================================
VITE_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_ALLOWED_HOSTNAMES=attozap.orbitalcode.shop

# ================================
# RESEND
# Domínio orbitalcode.shop já verificado.
# TLS obrigatório, remetente transacional e reply-to de suporte.
# ================================
RESEND_API_KEY=COLE_A_CHAVE_RESTRITA_SOMENTE_NA_VERCEL
RESEND_FROM=ATTOZAP <portal@orbitalcode.shop>
RESEND_REPLY_TO=suporte@orbitalcode.shop

# ================================
# INDIQUE E GANHE
# Valor inicial em centavos. Depois pode ser alterado pelo Control Center.
# ================================
REFERRAL_REWARD_CENTS=1000

# ================================
# MERCADO PAGO — ASSINATURAS + PIX
# Configure o webhook para:
# https://SEU_DOMINIO/api/mercadopago-webhook
# Eventos: subscription_preapproval, subscription_authorized_payment e payments
# ================================
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ================================
# STRIPE (opcional; pode coexistir com Mercado Pago)
# ================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_PLUS=price_xxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxx
STRIPE_PRICE_ULTRA=price_xxxxxxxxx
STRIPE_PRICE_ENTERPRISE=

# ================================
# LICENCIAMENTO ED25519
# A chave privada NUNCA deve usar prefixo VITE_ e nunca vai para o navegador.
# Use \n para representar quebras de linha na Vercel.
# ================================
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
